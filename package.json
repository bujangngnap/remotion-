{
  "name": "remotion-video-editor",
  "version": "1.0.0",
  "private": true,
  "description": "Project Remotion untuk mengedit video dengan React",
  "scripts": {
    "dev": "remotion studio",
    "render": "remotion render MyVideo out/video.mp4",
    "render:fotokita": "remotion render FotokitaPromo out/fotokita-promo.mp4",
    "render:promo": "remotion render Promo out/promo.mp4",
    "render:tkg": "remotion render TKGPromo out/tkg-promo.mp4",
    "render:tkg:vertical": "remotion render TKGPromo-Vertical out/tkg-promo-vertical.mp4",
    "render:showreel": "remotion render Showreel out/showreel-2026.mp4",
    "render:batik": "remotion render BatikEtiquette out/batik-etiquette.mp4 --codec h264 --crf 16",
    "render:kearifan": "remotion render KearifanLokal out/kearifan-lokal.mp4 --codec h264 --crf 16",
    "render:kearifan30old": "remotion render KearifanLokal30 out/kearifan-lokal-30fps.mp4 --codec h264 --crf 16",
    "upgrade": "remotion upgrade"
  },
  "dependencies": {
    "@remotion/cli": "4.0.533",
    "@remotion/google-fonts": "4.0.533",
    "@remotion/motion-blur": "^4.0.533",
    "@remotion/transitions": "4.0.533",
    "@remotion/zod-types": "4.0.533",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.533",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
